# Copy to .env.local for local development. Never commit populated secret values.
ATLAS_ENV=development
ATLAS_LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://atlas:atlas-local-only@localhost:55432/atlas
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000

# Required only for real provider smoke tests; deterministic tests use fakes.
OPENAI_API_KEY=
ATLAS_VISITOR_HMAC_SECRET=
ATLAS_OPERATOR_TOKEN=

# Optional LangSmith tracing. Keep disabled unless a local/deployment secret is configured.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=atlas-ai
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=

# Provider choices are configuration, not application literals.
ATLAS_ANSWER_MODEL=gpt-5.6-luna
ATLAS_REASONING_EFFORT=medium
ATLAS_EMBEDDING_MODEL=text-embedding-3-small
ATLAS_EMBEDDING_DIMENSIONS=1536
ATLAS_ANONYMOUS_ANSWER_LIMIT=10
ATLAS_ANONYMOUS_WINDOW_HOURS=24
ATLAS_CONTENT_RETENTION_DAYS=30
