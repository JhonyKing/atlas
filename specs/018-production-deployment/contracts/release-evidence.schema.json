{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/contracts/release-evidence-v1.json",
  "title": "ATLAS release evidence bundle",
  "type": "object",
  "required": ["release_id", "source_revision", "migration_revision", "checks", "smoke_results", "health", "created_at"],
  "properties": {
    "release_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 7},
    "web_build_id": {"type": ["string", "null"]},
    "api_image_digest": {"type": ["string", "null"]},
    "migration_revision": {"type": "string", "minLength": 1},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "smoke_results": {"type": "array", "items": {"$ref": "#/$defs/check"}},
  "health": {
    "type": "object",
    "required": ["environment", "status"],
    "properties": {
      "environment": {"enum": ["preview", "staging", "production", "unknown"]},
      "status": {"enum": ["ready", "degraded", "unavailable", "pending"]}
    },
    "additionalProperties": false
  },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["name", "status", "observed_at"],
      "properties": {
        "name": {"type": "string"},
        "status": {"enum": ["passed", "failed", "skipped"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "evidence_url": {"type": ["string", "null"]},
        "summary": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
