{
  "name": "atlas-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-first technical research with verifiable cited answers.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @atlas/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @atlas/web test:e2e"
    ,"test:auth": "powershell -NoProfile -File scripts/verify-auth.ps1",
    "test:ingestion": "powershell -NoProfile -File scripts/verify-ingestion.ps1",
    "test:agent": "powershell -NoProfile -File scripts/verify-agent.ps1",
    "test:retrieval": "powershell -NoProfile -File scripts/verify-retrieval.ps1",
    "test:model-router": "powershell -NoProfile -File scripts/verify-model-router.ps1",
    "test:security": "powershell -NoProfile -File scripts/verify-security.ps1",
    "test:slo": "powershell -NoProfile -File scripts/verify-slo.ps1",
    "test:evals": "powershell -NoProfile -File scripts/verify-evals.ps1",
    "test:eval-regression": "powershell -NoProfile -File scripts/run-eval-regression.ps1",
    "test:portfolio": "powershell -NoProfile -File scripts/verify-portfolio.ps1",
    "test:eval-gate": "powershell -NoProfile -File scripts/verify-eval-gate.ps1"
  }
}
